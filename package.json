  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/keithjjones/UnpackThePCAP/issues"
  },
  "homepage": "https://github.com/keithjjones/UnpackThePCAP#readme",
  "devDependencies": {
    "@slidev/cli": "^52.16.0",
    "playwright-chromium": "^1.63.0"
  },
  "dependencies": {
    "@slidev/theme-default": "^0.25.0"
  }
}
