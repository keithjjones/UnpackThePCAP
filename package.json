{
  "name": "unpackthepcap",
  "version": "1.0.0",
  "description": "UnpackThePCAP podcast slides",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "check:slides": "tools/check-slides.sh",
    "build:landing": "python3 tools/build_landing.py",
    "check:landing": "python3 tools/build_landing.py --check",
    "ep": "python3 tools/build_landing.py --find",
    "preview:landing": "python3 tools/build_landing.py --out /tmp/landing --slides-base https://unpackthepcap.com/ && open /tmp/landing/index.html",
    "shots:landing": "python3 tools/build_landing.py --out /tmp/landing --slides-base https://unpackthepcap.com/ && node tools/shoot-landing.js /tmp/landing/index.html output/screenshots"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keithjjones/UnpackThePCAP.git"
  },
  "keywords": [],
